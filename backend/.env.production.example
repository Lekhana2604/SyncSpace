# SyncSpace Backend Production Configuration (Render / Railway)
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://syncspace-app.netlify.app
JWT_SECRET=production_strong_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d

# MySQL Cloud Database (PlanetScale, Aiven, AWS RDS, Railway MySQL)
DB_HOST=aws.connect.psdb.cloud
DB_PORT=3306
DB_USER=production_user
DB_PASSWORD=production_secure_password
DB_NAME=syncspace_db
